SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Registration receipts via existing Titan Email mailbox (configure Vercel Production only).
# Use third-party SMTP access and a dedicated app password when supported; never commit credentials.
TITAN_SMTP_USER=
TITAN_SMTP_PASSWORD=
# Default smtp.titan.email; EU-hosted Titan may require smtp0101.titan.email.
TITAN_SMTP_HOST=smtp.titan.email
